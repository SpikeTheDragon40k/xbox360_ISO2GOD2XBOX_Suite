# Copy this file to .env (next to the scripts) and fill in your values:
#   cp .env.example .env && chmod 600 .env
#
# Command-line flags and real environment variables override these.
# Lines are KEY=value; quotes are optional; ~ expands to your home folder.

# --- iso2god-all.sh ---------------------------------------------------------
# Folder containing the .iso files
ISO_DIR=~/xbox360/isos
# Where converted GOD games are written (and uploaded from)
GOD_DIR=~/xbox360/isos/god
# Threads for iso2god
ISO2GOD_THREADS=16
# 1 = keep the ISOs after converting, 0 = delete them on success
KEEP_ISOS=0

# --- god2xbox.sh ------------------------------------------------------------
# Your console's IP address (optionally HOST:PORT)
XBOX_HOST=192.168.1.50
XBOX_FTP_USER=xboxftp
XBOX_FTP_PASS=xboxftp
# Content folder on the console
XBOX_REMOTE_PATH=/Hdd1/Content/0000000000000000
# 1 = delete each local game folder after a successful upload
DELETE_AFTER_UPLOAD=0
